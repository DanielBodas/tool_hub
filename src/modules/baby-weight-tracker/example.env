# -----------------------------------------------------------------------------
# BABY WEIGHT TRACKER MODULE ENVIRONMENT VARIABLES
# -----------------------------------------------------------------------------
# The PIN to lock access to this tool specifically (when not using Google OAuth)
BABY_WEIGHT_TRACKER_PIN=1234

# The name of the MongoDB database for this tool's data persistence
BABY_WEIGHT_TRACKER_DB_NAME=baby-weight-tracker

# Lista de emails de Google con acceso directo (separados por comas).
# Si no se define, cualquier sesión Google puede acceder.
BABY_WEIGHT_TRACKER_ALLOWED_USERS=usuario1@gmail.com,usuario2@gmail.com
