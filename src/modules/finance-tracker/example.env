# -----------------------------------------------------------------------------
# FINANCE TRACKER CONFIGURATION
# -----------------------------------------------------------------------------
# PIN de acceso exclusivo para la herramienta Finance Tracker.
FINANCE_TRACKER_PIN=1234
# Lista de emails de Google con acceso directo (separados por comas).
FINANCE_TRACKER_ALLOWED_USERS=usuario1@gmail.com,usuario2@gmail.com

# Mostrar en el panel a usuarios sin acceso directo (true/false, por defecto false).
# Si se establece a true, la herramienta aparecerá en el Dashboard y solicitará PIN al entrar.
FINANCE_TRACKER_VISIBLE_WITHOUT_ACCESS=false
