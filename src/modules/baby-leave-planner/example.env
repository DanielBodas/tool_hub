# -----------------------------------------------------------------------------
# BABY LEAVE PLANNER CONFIGURATION
# -----------------------------------------------------------------------------
# PIN de acceso exclusivo para la herramienta Baby Leave Planner.
BABY_LEAVE_PLANNER_PIN=1234

# Base de datos en MongoDB
BABY_LEAVE_PLANNER_DB_NAME=baby-leave-planner

# Lista de emails de Google con acceso directo (separados por comas).
BABY_LEAVE_PLANNER_ALLOWED_USERS=usuario1@gmail.com,usuario2@gmail.com

# Mostrar en el panel a usuarios sin acceso directo (true/false, por defecto false).
# Si se establece a true, la herramienta aparecerá en el Dashboard y solicitará PIN al entrar.
BABY_LEAVE_PLANNER_VISIBLE_WITHOUT_ACCESS=false
